    "@smithy/signature-v4": "4.2.4",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint-plugin-perfectionist": "5.9.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.22.4",
